{
  "_comment": "このファイルをコピーして config.json を作成してください。config.json は Git にコミットしないでください。",

  "_eodhd_comment": "enabled=false で EODHD を呼ばず yfinance のみで動作する（指数・価格は自動で yfinance にフォールバック）。有効なデータ契約がない場合は false にする。",
  "eodhd": {
    "api_key": "YOUR_EODHD_API_KEY",
    "base_url": "https://eodhd.com/api",
    "request_interval_sec": 0.5,
    "enabled": true
  },

  "slack": {
    "webhook_url": "https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ"
  },

  "capital": {
    "total_capital_jpy": 200000,
    "total_capital_usd": 1500,
    "max_risk_per_trade_pct": 2.0,
    "max_concurrent_holdings": 3,
    "default_stop_loss_pct": 8.0,
    "usdjpy_fallback": 150.0
  },

  "_markets_comment": "markets で市場ごとのスクリーニング有効化と戦略名を指定する。JP は swing_jp（EMA押し目スイング）、US は moomoo_swing。",
  "markets": {
    "us": {"enabled": true, "strategy": "moomoo_swing"},
    "jp": {"enabled": true, "strategy": "swing_jp"}
  },
  "swing": {
    "us_min_price": 10,
    "us_max_price": 50,
    "jp_min_price": 300,
    "jp_max_price": 3000,
    "ema_short": 25,
    "ema_long": 75,
    "rsi_max": 35,
    "rsi_lookback_days": 5,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "risk_reward_ratio": 2.0,
    "max_risk_per_trade_pct": 2.0,
    "max_unrealized_loss_pct": 6.0,
    "support_stop_buffer_pct": 1.0
  },

  "_exit_simple_comment": "保有銘柄の利確ルール。有効目標=2R連動。時間減衰(20%→…)はダッシュボード参考表示のみ。",
  "exit_simple": {
    "enabled": true,
    "r_target_mult": 2.0,
    "fallback_stop_loss_pct": 8.0,
    "initial_target_pct": 20.0,
    "target_decay_pct": 5.0,
    "target_decay_every_days": 30,
    "target_floor_pct": 5.0,
    "rsi_max_for_hold": 70.0,
    "partial_sell_ratio": 0.5,
    "stale_days_soft": 90,
    "stale_min_pnl_pct": 5.0,
    "stale_days_hard": 120,
    "stale_hard_min_pnl_pct": 10.0,
    "resistance_cap": {
      "enabled": true,
      "buffer_pct": 1.5,
      "min_reward_pct": 8.0,
      "ignore_if_above_pct": 25.0
    }
  },

  "investment_goal": {
    "monthly_deposit_jpy": 10000,
    "target_monthly_return_pct": 15.0
  },

  "risk_control": {
    "monthly_loss_stop_pct": 6.0,
    "max_consecutive_losses_before_pause": 3
  },

  "_rs_score_comment": "RSスコア（相対強度）: ベンチマーク対比の126日リターンを市場内百分位化。filter_enabled は既定OFF（記録・表示のみ）。",
  "rs_score": {
    "enabled": true,
    "lookback_days": 126,
    "jp_benchmark": "N225",
    "us_benchmark": "SP500",
    "min_rs_score": 70,
    "filter_enabled": false,
    "dynamic_rsi_enabled": true,
    "dynamic_rsi_base": 35,
    "dynamic_rsi_anchor_score": 70,
    "dynamic_rsi_slope": 0.5,
    "dynamic_rsi_max": 55
  },

  "_breakout_comment": "ブレイクアウト戦略: 60日高値更新 + 出来高急増。enabled:false で無効化。",
  "breakout": {
    "enabled": true,
    "high_lookback_days": 60,
    "volume_ratio_min": 1.5,
    "max_candidates_per_batch": 1,
    "min_rs_score": null
  },

  "_market_filter_comment": "市場環境モード: per_market_mode=true で日本株は日経平均のみ、米国株は S&P500 のみで判定（他市場の下落で巻き添えに停止しない）。false で従来の全体モードに戻る。index_max_stale_days は指数データの許容鮮度（日）で、これより古い場合は判定不能=警戒扱い。0 で無効。",
  "market_filter": {
    "per_market_mode": true,
    "index_max_stale_days": 5
  },

  "_signal_comment": "candidate_max_atr_pct は候補に許容するボラティリティ（ATR14 ÷ 株価、%）の上限。これを超える銘柄は candidate にせず watch に落とす。実績では ATR 比 6% 超の候補が 20営業日後に平均 -12%〜-22%（上昇率 20%/12%）と大きく負け越したため既定 6.0。0 で無効。",
  "signal": {
    "candidate_max_atr_pct": 6.0,
    "pattern_a_rsi_min": 50,
    "pattern_a_rsi_max": 70,
    "pattern_a_volume_ratio_min": 1.2,
    "pattern_a_52w_high_pct": 0.92,
    "pattern_b_rsi_min": 40,
    "pattern_b_rsi_max": 60,
    "pattern_b_ma25_touch_pct": 0.98,
    "pattern_b_lookback_days": 5,
    "pattern_b_bounce_confirm_days": 1,
    "atr_stop_multiplier": 2.0,
    "risk_reward_ratio": 2.0,
    "max_entry_sets_per_batch": 3,
    "stop_loss_warning_min_pct": 1.0,
    "stop_loss_warning_max_pct": 15.0,
    "pattern_c_rsi_max": 35,
    "pattern_c_support_tolerance_pct": 3.0,
    "pattern_c_sar_af_start": 0.02,
    "pattern_c_sar_af_step": 0.02,
    "pattern_c_sar_af_max": 0.20,
    "pattern_c_support_lookback_days": 120
  },

  "screening": {
    "jp_min_price": 300,
    "jp_min_turnover": 300000000,
    "jp_min_market_cap": 30000000000,
    "us_min_price": 5,
    "us_min_turnover": 20000000,
    "us_min_market_cap": 2000000000,
    "min_active_days_of_30": 20,
    "allow_unknown_market_cap": true,
    "us_shares_refresh_enabled": false,
    "us_shares_refresh_max_per_monthly": 200,
    "us_shares_refresh_interval_sec": 0.25
  },

  "_universe_prefilter_comment": "価格取得の事前フィルタ。US は universe_master に約1.8万銘柄あり yfinance の全件取得だけで約22分かかるが、直近3か月に売買代金 us_min_turnover を一度でも超えた銘柄は3,500件程度しかない。min_turnover_ratio は screening.*_min_turnover に対する倍率で、この割合を下回る銘柄を日次の取得対象から外す。価格履歴が無い銘柄と保有中の銘柄は常に取得する。full_refresh_weekday（月=0…土=5、-1で無効）の日は全銘柄を取得して売買代金の実績を更新する。enabled=false で無効。",
  "universe_prefilter": {
    "enabled": true,
    "markets": ["US"],
    "lookback_days": 90,
    "min_turnover_ratio": 0.25,
    "full_refresh_weekday": 5
  },

  "schedule": {
    "evening_jp_target_time": "20:30",
    "morning_all_target_time": "07:30"
  },

  "database": {
    "db_path": "./data/investment.db",
    "backup_dir": "./data/backup",
    "backup_retention_days": 7
  },

  "logging": {
    "log_dir": "./logs",
    "log_level": "INFO"
  },

  "initial_fetch": {
    "history_years": 3
  },

  "report_server": {
    "host": "127.0.0.1",
    "port": 5100
  },

  "jquants": {
    "api_key": "YOUR_JQUANTS_V2_API_KEY",
    "auth_type": "api_key",
    "use_bulk_fundamentals": false,
    "max_fundamentals_per_run": 300,
    "request_interval_sec": 13.0,
    "rate_limit_wait_sec": 65.0,
    "max_retries": 3,
    "earnings_alert_days_warning": 7,
    "earnings_alert_days_critical": 3
  },

  "_paper_mode_comment": "paper_mode を有効にすると、シグナル発生時に仮想エントリーを記録し、日次で損切り・利確を自動判定する。運用開始前の検証期間（1〜3か月）に使用する。",
  "paper_mode": {
    "enabled": false,
    "entry_slippage_pct": 0.0
  },

  "_moomoo_comment": "moomoo セクションは任意。moomoo OpenD から保有銘柄を同期する場合のみ設定する。watchlist.enabled を true にする場合は、moomoo アプリでカスタムグループ「システム候補」を事前作成すること。注意: OpenAPI のお気に入り追加は US 株のみ対応（Moomoo JP 口座では日本株は API 非対応）。",
  "moomoo": {
    "host": "127.0.0.1",
    "port": 11111,
    "watchlist": {
      "enabled": false,
      "group_name": "システム候補",
      "min_days_before_remove": 7,
      "exclude_holdings": true,
      "exclude_bookmarked": true
    },
    "watchlist_monitor": {
      "enabled": false,
      "group_name": "All",
      "group_name_fallbacks": ["All", "Favorites", "US"],
      "markets": ["US"],
      "macd_require_both": true,
      "respect_market_mode": true,
      "max_alerts_per_run": 10
    }
  },

  "_llm_comment": "llm セクションは任意。有効にすると、バッチ実行時に買い候補・保有銘柄のデータを LLM に送り、フィードバックを Slack 通知に含める。enabled を true にし、使用するプロバイダーの api_key を設定する。",
  "llm": {
    "enabled": false,
    "openai": {
      "enabled": true,
      "api_key": "YOUR_OPENAI_API_KEY",
      "model": "gpt-4.1",
      "max_tokens": 1600,
      "temperature": 0.3,
      "timeout_sec": 60
    },
    "anthropic": {
      "enabled": true,
      "api_key": "YOUR_ANTHROPIC_API_KEY",
      "model": "claude-opus-4-6",
      "max_tokens": 1600,
      "temperature": 0.3,
      "timeout_sec": 60
    },
    "gemini": {
      "enabled": true,
      "api_key": "YOUR_GEMINI_API_KEY",
      "model": "gemini-2.5-pro",
      "max_tokens": 1600,
      "temperature": 0.3,
      "timeout_sec": 60
    }
  },

  "_committee_comment": "committee セクションは任意。投資委員会（マルチエージェント判定）を有効にすると、買い候補と売り検討/損切り接近の保有銘柄を複数エージェントが審議し、判定を Slack 通知に含める。API キーは llm.<provider>.api_key を共用する（llm.enabled が false でも使える）。pricing_usd_per_1m は推定コスト計算用の単価（USD/100万トークン）で、実際の価格に合わせて更新すること。未登録モデルは default 単価で計算する。詳細は docs/investment_committee_requirements.md。",
  "committee": {
    "enabled": false,
    "max_subjects_per_batch": 3,
    "daily_budget_jpy": 45,
    "min_analysts": 2,
    "temperature": 0.2,
    "usdjpy_for_cost": 150.0,
    "agents": {
      "macro":       {"provider": "openai",    "model": "gpt-4.1-mini",      "max_tokens": 600},
      "fundamental": {"provider": "openai",    "model": "gpt-4.1-mini",      "max_tokens": 600},
      "technical":   {"provider": "openai",    "model": "gpt-4.1-mini",      "max_tokens": 600},
      "risk":        {"provider": "openai",    "model": "gpt-4.1-mini",      "max_tokens": 600},
      "pm":          {"provider": "anthropic", "model": "claude-sonnet-4-5", "max_tokens": 900}
    },
    "pricing_usd_per_1m": {
      "default":           {"input": 3.0, "output": 15.0},
      "gpt-4.1-mini":      {"input": 0.4, "output": 1.6},
      "claude-sonnet-4-5": {"input": 3.0, "output": 15.0}
    }
  }
}
